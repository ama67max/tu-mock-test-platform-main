NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://tu_user:tu_pass@localhost:5432/tu_db
REDIS_URL=redis://localhost:6379

# Set to clerk in environments using Clerk authentication.
AUTH_PROVIDER=clerk
CLERK_SECRET_KEY=sk_test_replace_me

JWT_ACCESS_SECRET=replace_with_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_at_least_32_characters
FRONTEND_URL=http://localhost:5173
# Comma-separated additional frontend origins, such as the exact VS Code forwarded URL.
# Do not include a path; use the origin only, for example https://your-name-5173.app.github.dev
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:5173
LOG_LEVEL=info