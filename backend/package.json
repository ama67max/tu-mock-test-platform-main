{
  "name": "tu-mock-test-backend",
  "version": "1.0.0",
  "description": "Backend API for TU Mock Test Platform - scalable, production-ready",
  "main": "server.js",
  "type": "commonjs",
  "eslintConfig": {
    "env": {
      "commonjs": true,
      "es2022": true,
      "jest": true,
      "node": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": "latest"
    },
    "ignorePatterns": [
      "coverage/",
      "uploads/",
      "dump.rdb"
    ],
    "rules": {
      "no-unused-vars": "off",
      "no-case-declarations": "off"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "dotenv -e .env.test -- jest --coverage --runInBand",
    "test:watch": "dotenv -e .env.test -- jest --watch",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "tu-mock-test",
    "ioe",
    "csit",
    "cmat",
    "bca",
    "bit",
    "entrance-exam",
    "nepal"
  ],
  "author": "TU Mock Test Team",
  "license": "MIT",
  "dependencies": {
    "@clerk/backend": "^3.16.9",
    "@prisma/client": "^5.16.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "rate-limit-redis": "^4.2.0",
    "redis": "^6.2.1",
    "socket.io": "^4.7.5",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prisma": "^5.16.0",
    "supertest": "^7.0.0"
  }
}
