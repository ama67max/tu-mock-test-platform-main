{
  "name": "tu-mock-test-load-test",
  "version": "1.0.0",
  "description": "K6 load testing scripts for TU Mock Test Platform",
  "scripts": {
    "test": "k6 run load-test.js",
    "test:staging": "k6 run -e ENVIRONMENT=staging -e BASE_URL=https://staging-api.example.com/api/v1 load-test.js",
    "test:production": "k6 run -e ENVIRONMENT=production -e BASE_URL=https://api.example.com/api/v1 load-test.js",
    "test:json": "k6 run --out json=results.json load-test.js",
    "test:influxdb": "k6 run --out influxdb=http://localhost:8086/k6 load-test.js",
    "test:smoke": "k6 run -e ENVIRONMENT=smoke load-test.js",
    "test:stress": "k6 run -e ENVIRONMENT=stress load-test.js",
    "report": "k6 run --out json=results.json load-test.js && k6 report results.json"
  },
  "keywords": [
    "k6",
    "load-testing",
    "performance-testing",
    "stress-testing"
  ],
  "author": "TU Mock Test Team",
  "license": "MIT",
  "devDependencies": {},
  "engines": {
    "k6": ">=0.43.0"
  }
}
